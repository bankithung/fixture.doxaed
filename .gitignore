# Python / Django
__pycache__/
*.py[cod]
*.egg-info/
.venv/
backend/.venv/
*.sqlite3
backend/staticfiles/
backend/media/
# Secrets / env (keep *.env.example)
.env
backend/.env
*.local.env
# Node / frontend
node_modules/
frontend/node_modules/
frontend/dist/
# Tooling / editor / OS artifacts
.playwright-mcp/
*.log
.DS_Store
Thumbs.db
.idea/
.vscode/

# Local production secrets (never commit)
deploy/CREDENTIALS-PROD.md

# Seeded demo/admin credentials — never commit
backend/scripts/CREDENTIALS.md

# Local Claude/commandcode tooling state. NEVER commit: its cached shell
# permission entries embed live credentials (a plaintext PGPASSWORD was found
# in here on 2026-08-27), and this repository is public.
.commandcode/

# Claude Code per-machine permission allowlist. Ignored here (not only in a
# global gitignore) so a fresh clone on another machine agrees about what is
# untracked, and so it can never be swept into a commit on this public repo.
.claude/settings.local.json
