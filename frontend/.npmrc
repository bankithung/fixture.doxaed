# openapi-typescript (devDependency, used only by `npm run gen:types`) still
# declares `peer typescript@^5.x` while this project is on typescript ~6.0.
# Strict peer resolution therefore makes `npm ci` ERESOLVE and hard-fail, which
# silently broke the deploy pipeline: the auto-deploy runs `npm ci` whenever
# package-lock.json changes, so the next dependency bump would not have shipped.
# Nothing in `npm run build` touches openapi-typescript, so accepting the stale
# peer range is safe -- and this keeps the dev box, the deploy and CI resolving
# the tree identically instead of hiding the flag in one script.
legacy-peer-deps=true
