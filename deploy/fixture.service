[Unit]
Description=Fixture Platform ASGI (gunicorn + uvicorn worker)
After=network.target postgresql.service redis-server.service
Wants=postgresql.service redis-server.service

[Service]
Type=notify
User=ubuntu
Group=www-data
WorkingDirectory=/home/ubuntu/Fixture/backend
Environment=DJANGO_SETTINGS_MODULE=fixture.settings.prod
Environment=PYTHONUNBUFFERED=1
# Creates /run/fixture (owned ubuntu:www-data, 0750) for the gunicorn socket.
RuntimeDirectory=fixture
RuntimeDirectoryMode=0750
ExecStart=/home/ubuntu/Fixture/backend/.venv/bin/gunicorn \
    -c /home/ubuntu/Fixture/deploy/gunicorn.conf.py \
    fixture.asgi:application
ExecReload=/bin/kill -s HUP $MAINPID
Restart=always
RestartSec=3
KillMode=mixed
TimeoutStopSec=30

# Resource protection (2026-08-19). This box is 2 vCPU / 1.9GB and also hosts
# dev work (test suites, tsc, vite builds). Without these the app competed with
# them on equal terms and lost: workers were pushed into swap and served
# requests in 7-30s while a Claude session ran 7 concurrent jobs.
# MemoryMin is a GUARANTEE, not a cap - the kernel will not reclaim below it.
# Applied live with `systemctl set-property` (no restart needed); these lines
# keep the values if the unit is ever reinstalled on a fresh box.
MemoryMin=400M
CPUWeight=800
IOWeight=800

# Hardening
NoNewPrivileges=true
ProtectSystem=full
PrivateTmp=true

[Install]
WantedBy=multi-user.target
